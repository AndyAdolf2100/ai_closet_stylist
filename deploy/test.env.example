# For DEPLOY_ENV=test. Install on server as /opt/aicloset-agent/config/test.env; never commit credentials.
# PostgreSQL: aicloset_stylist_test. MySQL settings currently remain shared with dev.
STYLIST_ENV=production
STYLIST_REQUIRE_POSTGRES=true
STYLIST_REQUIRE_MIGRATIONS=true
STYLIST_SERVER_URL=https://aicloset-test.wxbjq.top
STYLIST_MCP_URL=https://aicloset-test.wxbjq.top/mcp
STYLIST_USAGE_CALLBACK_URL=https://aicloset-test.wxbjq.top/api/internal/stylist/model-usage
STYLIST_USAGE_ENVIRONMENT=test
STYLIST_DATABASE=postgresql://REPLACE_SHARED_USER:REPLACE_SHARED_PASSWORD@REPLACE_SHARED_POSTGRES_HOST:5432/aicloset_stylist_test
STYLIST_CHECKPOINT_DATABASE=
STYLIST_LLM_URL=REPLACE_LLM_URL
STYLIST_LLM_MODEL=deepseek-v4-1-flash-261017
STYLIST_LLM_KEY=REPLACE_PRIVATE_LLM_KEY
STYLIST_ALLOW_MOBILE_LOGIN=true
STYLIST_LOGIN_PUBLIC_KEY=/run/stylist/login-public.pem
STYLIST_LOGIN_APP_VERSION=1.2.0
STYLIST_OPS_MYSQL_DSN=mysql://REPLACE_READONLY_USER:REPLACE_PASSWORD@REPLACE_SHARED_MYSQL_INTERNAL_HOST:3306/REPLACE_DATABASE
