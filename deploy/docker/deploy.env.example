# Copy to config/deploy.env, chmod 600. Never include real keys in Git or the image.
# Upstream endpoints from the adjacent project's configuration (not hosted by this image).
STYLIST_SERVER_URL=https://aicloset-dev.wxbjq.top
STYLIST_MCP_URL=https://aicloset-dev.wxbjq.top/mcp
STYLIST_LLM_URL=https://ark.cn-beijing.volces.com/api/v3
STYLIST_LLM_MODEL=REPLACE_WITH_YOUR_MODEL_ID
STYLIST_LLM_KEY=REPLACE_WITH_YOUR_MODEL_KEY
STYLIST_LOGIN_APP_VERSION=1.2.0
# Standalone test website: explicitly enable phone/code login, served through HTTPS.
# false retains the default production restriction for existing App integrations.
STYLIST_ALLOW_MOBILE_LOGIN=true
# Optional official warning feed; leave empty until an actual provider is configured.
STYLIST_ALERTS_URL=
STYLIST_ALERTS_KEY=

# Dedicated Stylist PostgreSQL database; URL-encode username/password. Never use legacy databases.
STYLIST_DATABASE=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/aicloset_stylist
# Empty uses the same PostgreSQL database for checkpoints.
STYLIST_CHECKPOINT_DATABASE=
